{
  "name": "protvista-pdb",
  "version": "4.0.0",
  "description": "PDB ProtVista Viewer",
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/protvista-pdb.umd.min.js",
  "module": "./dist/protvista-pdb.es.min.js",
  "exports": {
    ".": {
      "import": "./dist/protvista-pdb.es.min.js",
      "require": "./dist/protvista-pdb.umd.min.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Mandar Deshpande <mandar@ebi.ac.uk>",
  "contributors": [
    "Typhaine Paysan-Lafosse <typhaine@ebi.ac.uk>",
    "Sreenath Nair <sreenath@ebi.ac.uk>",
    "Marcelo Querino Lima Afonso <marcelo@ebi.ac.uk>",
    "Adam Midlik <midlik@ebi.ac.uk>"
  ],
  "license": "Apache 2.0",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "vite --open examples/minimal/index.html",
    "dev:build": "vite --open examples/build/index.html",
    "build": "vite build",
    "test:build": "npm run build && npm run dev:build",
    "preview": "vite preview",
    "watch": "vite build --watch"
  },
  "dependencies": {
    "@nightingale-elements/nightingale-conservation-track": "^5.6.0",
    "@nightingale-elements/nightingale-linegraph-track": "^5.6.0",
    "@nightingale-elements/nightingale-manager": "^5.6.0",
    "@nightingale-elements/nightingale-navigation": "^5.6.0",
    "@nightingale-elements/nightingale-new-core": "^5.6.0",
    "@nightingale-elements/nightingale-scrollbox": "^5.6.0",
    "@nightingale-elements/nightingale-sequence": "^5.6.0",
    "@nightingale-elements/nightingale-sequence-heatmap": "^5.6.2",
    "@nightingale-elements/nightingale-track": "^5.6.0",
    "@nightingale-elements/nightingale-track-canvas": "^5.6.0",
    "@nightingale-elements/nightingale-variation": "^5.6.0",
    "d3": "^7.9.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "terser": "^5.48.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
